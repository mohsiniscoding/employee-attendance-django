# Django Settings
SECRET_KEY= # Your Django secret key (generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
DEBUG=True # Set to False in production
ALLOWED_HOSTS=localhost,127.0.0.1 # Comma-separated list of allowed hosts

# AWS S3 Storage (optional - if not set, will use local file storage)
AWS_ACCESS_KEY= # Your AWS S3 Access Key ID
AWS_SECRET_KEY= # Your AWS Access Key ID
AWS_REGION_NAME= # Your AWS S3 Region Name
AWS_BUCKET_NAME= # Your AWS S3 Bucket Name